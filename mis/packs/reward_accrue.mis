// Title: Liquid Staking Core · RewardAccrue

module LiquidStakingCoreRewardAccrue {

  embed gates 3..=6 {
    context: "RewardAccrue pack on MIS domain liquid_staking — CLRTY-1";
    ai: "Index via mis_code_index + moniversive_invariant_static_ML";
